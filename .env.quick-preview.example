# Copy to .env.quick-preview. This configuration is for a short, invitation-
# only professor demonstration without a custom domain.
WOUNDCARE_ENV=production
WOUNDCARE_HOST=0.0.0.0
PORT=8000
WOUNDCARE_PROFESSOR_PREVIEW=true
WOUNDCARE_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_UNIQUE_16_PLUS_CHARACTER_PASSWORD
WOUNDCARE_FERNET_KEY=REPLACE_WITH_A_NEW_FERNET_KEY
WOUNDCARE_DB_PATH=/data/professor_preview.db
WOUNDCARE_KEY_PATH=/data/unused_in_production.key
WOUNDCARE_SESSION_TTL_HOURS=4
WOUNDCARE_LOGIN_MAX_ATTEMPTS=8
WOUNDCARE_LOGIN_WINDOW_SECONDS=900
WOUNDCARE_MAX_UPLOAD_BYTES=10485760

# The generated HTTPS host changes for every tunnel session. The UI and API are
# same-origin, so no cross-origin browser access is allowed or required.
WOUNDCARE_ALLOWED_ORIGINS=https://not-used.invalid
WOUNDCARE_ALLOWED_HOSTS=*.trycloudflare.com,127.0.0.1,localhost

# Mount only sealed weights into ./models and record their SHA-256 in the
# professor handoff. Do not copy datasets or blind-test images into ./models.
WOUNDCARE_CLS_MODEL=/models/C-Arch-05-sealed.pt
WOUNDCARE_SEG_MODEL=/models/ROI-display-only.pt
WOUNDCARE_DET_MODEL=/models/legacy-detector.pt
WOUNDCARE_SEG_CONFIDENCE=0.10
WOUNDCARE_CLS_CONFIDENCE=0.60
WOUNDCARE_SEG_IMGSZ=384
WOUNDCARE_SEG_DEVICE=cpu
WOUNDCARE_CLASSIFICATION_SOURCE=full_image
