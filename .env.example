# Copy to .env only for local deployment. Never commit the real values.
WOUNDCARE_ENV=development
WOUNDCARE_BOOTSTRAP_PASSWORD=replace-with-a-unique-12-plus-character-password
WOUNDCARE_FERNET_KEY=
WOUNDCARE_SESSION_TTL_HOURS=8
WOUNDCARE_MAX_UPLOAD_BYTES=10485760
WOUNDCARE_LOGIN_MAX_ATTEMPTS=8
WOUNDCARE_LOGIN_WINDOW_SECONDS=900
WOUNDCARE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WOUNDCARE_ALLOWED_HOSTS=127.0.0.1,localhost
WOUNDCARE_DET_MODEL=Wound_AI_Detection_v2/R1_YOLO11m_82/weights/best.pt
WOUNDCARE_CLS_MODEL=runs/classify/wound_classifier_v32/weights/best.pt
WOUNDCARE_SEG_MODEL=experiments/results/segmentation/YOLO11m_WSNet_seg_aug_v5_20260818/weights/best.pt
WOUNDCARE_SEG_CONFIDENCE=0.10
WOUNDCARE_CLS_CONFIDENCE=0.60
WOUNDCARE_SEG_IMGSZ=384
WOUNDCARE_SEG_DEVICE=cpu
WOUNDCARE_CLASSIFICATION_SOURCE=full_image
WOUNDCARE_PROFESSOR_PREVIEW=false
